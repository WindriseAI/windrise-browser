diff --git a/chrome/common/extensions/api/windrise.idl b/chrome/common/extensions/api/windrise.idl
new file mode 100644
index 0000000000..426ba49623
--- /dev/null
+++ b/chrome/common/extensions/api/windrise.idl
@@ -0,0 +1,312 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// windrise API for accessing system-level browser functionality
+namespace windrise {
+
+  // Selection type for choosePath.
+  // file: Only files can be selected (default).
+  // folder: Only folders/directories can be selected.
+  enum SelectionType {
+    file,
+    folder
+  };
+
+  // Options for choosePath
+  dictionary ChoosePathOptions {
+    // Restrict what can be selected.
+    // Default: file
+    SelectionType? type;
+
+    // Title displayed in the dialog window.
+    // Default: OS-provided default title
+    DOMString? title;
+
+    // Starting directory for the dialog.
+    // If invalid or not provided, falls back to OS default.
+    DOMString? startingDirectory;
+  };
+
+  // Result from choosePath
+  dictionary SelectedPath {
+    // Full absolute path (e.g., "/Users/user/projects/myapp")
+    DOMString path;
+
+    // File or folder name (e.g., "myapp")
+    DOMString name;
+  };
+
+  // Options for setAddressBarSlot.
+  dictionary AddressBarSlotOptions {
+    // The id of the tab whose address bar slot should be updated.
+    long tabId;
+
+    // Whether the slot should be shown or hidden.
+    boolean visible;
+
+    // Text shown in the slot. Omitted or null clears the text.
+    DOMString? text;
+  };
+
+  // A connected AI (used by the card and panel).
+  dictionary AiConnection {
+    // Display name (for example Claude).
+    DOMString name;
+
+    // PNG of at most 16x16, base64 encoded. Empty string means no icon.
+    DOMString? iconPng;
+
+    // Minutes since the last call. Negative means no time is shown.
+    long? lastActiveMinutes;
+  };
+
+  // Options for setAiTabs (sectioned tab list).
+  dictionary SetAiTabsOptions {
+    // Any tab currently owned by the AI (used to locate the window).
+    long tabId;
+
+    // AI name; the browser uses it in the section title.
+    DOMString aiName;
+
+    // Tab ids that belong to this AI. An empty array clears the section.
+    long[] tabIds;
+  };
+
+  // Options for setConnectedAis .
+  dictionary SetConnectedAisOptions {
+    // Any tab in the window (used to locate the window).
+    long tabId;
+
+    // Connected AIs; the order is the row order in the panel.
+    AiConnection[] connections;
+  };
+
+  // Options for setAiActivity (edge light).
+  dictionary SetAiActivityOptions {
+    // The tab the AI is operating on.
+    long tabId;
+
+    // true starts the edge light, false fades it out.
+    boolean active;
+
+    // Same name as setAiTabs. Omitted: legacy latest-AI attribution and
+    // tab-wide stop; provided: start/stop only this AI's activity on the tab.
+    DOMString? aiName;
+  };
+
+  // Options for setEdgeLightMode (where the edge light is drawn).
+  dictionary SetEdgeLightModeOptions {
+    // "page": the extension draws it inside the page (default).
+    // "layer": a transparent, input-less web view over the web contents loads
+    // the calling extension's edge-light/frame.html.
+    // "skia" is accepted for older callers and treated as "page".
+    DOMString mode;
+  };
+
+  // Options for pulseAiActivity (edge light, one pulse per action).
+  dictionary PulseAiActivityOptions {
+    // The tab that performed the action.
+    long tabId;
+
+    // Action position in logical page pixels (relative to the top-left of
+    // the web contents). Pass both or neither; without a position the pulse
+    // rings the whole edge.
+    double? x;
+    double? y;
+  };
+
+  // Settings-related types
+  dictionary PrefObject {
+    DOMString key;
+    DOMString type;
+    any value;
+  };
+
+  // Callback for settings functions
+  callback GetPrefCallback = void(PrefObject pref);
+  callback SetPrefCallback = void(boolean success);
+
+  // Callback for metrics logging
+  callback VoidCallback = void();
+
+  // Callback for getting version number
+  callback GetVersionNumberCallback = void(DOMString version);
+
+  // Callback for choosePath.
+  // |result|: Selected path info, or null if user cancelled.
+  callback ChoosePathCallback = void(optional SelectedPath result);
+
+  // Callback for showToast.
+  // |shown|: True if the toast was displayed, false if it was suppressed.
+  callback ShowToastCallback = void(boolean shown);
+
+  // Callback for showInfoBar.
+  callback ShowInfoBarCallback = void(boolean shown);
+
+  // Snapshot of this profile's current provider; query is expanded by Chromium.
+  dictionary DefaultSearchEngine {
+    DOMString name;
+    DOMString iconUrl;
+    DOMString searchUrl;
+  };
+  callback GetDefaultSearchEngineCallback = void(DefaultSearchEngine engine);
+
+  // Current browser chrome color scheme.
+  dictionary ColorSchemeState {
+    // One of "system", "light", "dark".
+    DOMString mode;
+    // Effective dark-mode state resolved for the profile's windows.
+    boolean dark;
+  };
+  callback GetColorSchemeCallback = void(ColorSchemeState state);
+
+  interface Functions {
+    // Read-only. Never changes the profile's provider or starts navigation.
+    static void getDefaultSearchEngine(
+        DOMString query,
+        GetDefaultSearchEngineCallback callback);
+
+    // Sets the profile's default search engine to a built-in preset
+    // ("google" or "baidu"). Restricted to the verified Windrise assistant.
+    static void setDefaultSearchEngine(
+        DOMString providerId,
+        SetPrefCallback callback);
+
+    // Sets both "On startup" and the Home button to open the New Tab page.
+    // Does not accept arbitrary URLs. Restricted to the verified Windrise
+    // assistant.
+    static void setNewTabAsHomePage(SetPrefCallback callback);
+
+    // Gets the profile's browser chrome color scheme ("system", "light", or
+    // "dark") and effective dark state. Restricted to the verified Windrise
+    // assistant.
+    static void getColorScheme(GetColorSchemeCallback callback);
+
+    // Sets the profile's browser chrome color scheme ("system", "light", or
+    // "dark") and repaints open windows immediately. Restricted to the
+    // verified Windrise assistant.
+    static void setColorScheme(
+        DOMString mode,
+        SetPrefCallback callback);
+
+    // Settings API functions - compatible with chrome.settingsPrivate
+    // Gets a specific preference value
+    // |name|: The preference name (e.g., "nxtscape.default_provider").
+    // |callback|: Called with the preference object.
+    static void getPref(
+        DOMString name,
+        GetPrefCallback callback);
+
+    // Sets a specific preference value
+    // |name|: The preference name (e.g., "nxtscape.default_provider").
+    // |value|: The value to set.
+    // |pageId|: Optional page ID for settings tracking (can be empty string).
+    // |callback|: Called with success status.
+    static void setPref(
+        DOMString name,
+        any value,
+        optional DOMString pageId,
+        SetPrefCallback callback);
+
+    // Logs a metric event with optional properties
+    // |eventName|: The name of the event to log (e.g., "extension.action").
+    // |properties|: Optional JSON object with additional properties.
+    // |callback|: Called when the metric is logged.
+    static void logMetric(
+        DOMString eventName,
+        optional object properties,
+        optional VoidCallback callback);
+
+    // Gets the browser version number
+    // |callback|: Called with the version string.
+    static void getVersionNumber(
+        GetVersionNumberCallback callback);
+
+    // Gets the Windrise browser version number
+    // |callback|: Called with the version string.
+    static void getWindriseVersionNumber(
+        GetVersionNumberCallback callback);
+
+    // Opens a native OS file/folder picker dialog.
+    // Returns the selected path or null if the user cancels.
+    //
+    // |options|: Configuration for the picker dialog.
+    // |callback|: Called with the result.
+    //
+    // Errors:
+    // - "Could not show file dialog" if no browser window context available
+    static void choosePath(
+        optional ChoosePathOptions options,
+        ChoosePathCallback callback);
+
+    // Shows a transient toast notification in the active browser window. The
+    // message is supplied dynamically, so no resource string is required.
+    // |message|: The text to display in the toast.
+    // |durationMs|: How long the toast stays visible, in milliseconds. Clamped
+    //     to [1000, 30000]. Defaults to the standard toast timeout if omitted.
+    // |callback|: Called with true if the toast was shown, false if it was
+    //     suppressed (e.g. by the user's toast alert-level setting).
+    static void showToast(
+        DOMString message,
+        optional long durationMs,
+        ShowToastCallback callback);
+
+    // Shows a simple alert infobar in the active browser tab.
+    // |message|: Text to display.
+    // |callback|: Called with whether the infobar was shown.
+    static void showInfoBar(
+        DOMString message,
+        ShowInfoBarCallback callback);
+
+    // Windrise tells the browser which tabs belong to the current AI.
+    // The browser groups them into the last section of the side panel.
+    static void setAiTabs(SetAiTabsOptions options, optional VoidCallback callback);
+
+    // Windrise data for the bottom-left connected-AI card and panel.
+    static void setConnectedAis(
+        SetConnectedAisOptions options,
+        optional VoidCallback callback);
+
+    // Windrise turns the AI operation edge light on or off for a tab.
+    static void setAiActivity(
+        SetAiActivityOptions options,
+        optional VoidCallback callback);
+
+    // Windrise chooses where the edge light is drawn. Stored in a
+    // profile pref; takes effect on the next frame of every window.
+    static void setEdgeLightMode(
+        SetEdgeLightModeOptions options,
+        optional VoidCallback callback);
+
+    // Windrise called once per AI action (click, typing, navigation,
+    // scroll) so the edge light pulses. Ignored unless setAiActivity is on.
+    static void pulseAiActivity(
+        PulseAiActivityOptions options,
+        optional VoidCallback callback);
+
+    // Shows, updates or hides the generic address bar slot for a tab.
+    // |options|: The tab, visibility and optional text.
+    // |callback|: Called when the slot has been updated.
+    //
+    // Errors:
+    // - "No tab with id: N" if the tab cannot be found.
+    static void setAddressBarSlot(
+        AddressBarSlotOptions options,
+        optional VoidCallback callback);
+  };
+
+  interface Events {
+    // Fired when the address bar slot of a tab is clicked.
+    // |tabId|: The id of the tab that owns the slot.
+    static void onAddressBarSlotClicked(long tabId);
+
+    // Fired when the Windrise toolbar grid button is clicked. The extension
+    // owns what "grid mode" looks like; the browser only reports the click.
+    static void onGridButtonClicked();
+
+    // Windrise a panel footer button was clicked. |action| is "open_app",
+    // "grid" or "settings".
+    static void onAiPanelAction(DOMString action);
+  };
+};
