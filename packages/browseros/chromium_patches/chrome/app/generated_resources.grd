diff --git a/chrome/app/generated_resources.grd b/chrome/app/generated_resources.grd
index b9d0f60014..12517f3884 100644
--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -9412,6 +9412,54 @@ Keep your key file in a safe place. You will need it to create new versions of y
       <message name="IDS_READ_LATER_COLLAPSE_BUTTON_ARIA_LABEL" desc="Aria label for the Read later list collapse button.">
         Collapse <ph name="HEADER">$1<ex>Unread</ex></ph>
       </message>
+      <message name="IDS_THIRD_PARTY_LLM_TITLE" desc="Title for 3rd party LLM side panel">
+        Chat 
+      </message>
+      <message name="IDS_WINDRISE_GRID" desc="Label of the Windrise toolbar button that opens grid mode">
+        Grid
+      </message>
+      <message name="IDS_WINDRISE_AI_CONNECTED_COUNT" desc="Windrise: bottom-left card showing how many AIs are connected to the browser">
+        <ph name="NUM">$1<ex>2</ex></ph> AIs connected
+      </message>
+      <message name="IDS_WINDRISE_AI_NONE_CONNECTED" desc="Windrise: bottom-left card shown when no AI is connected to the browser">
+        No AI connected
+      </message>
+      <message name="IDS_WINDRISE_AI_OPERATING" desc="Windrise: header of the side panel section that lists the tabs an AI is currently using">
+        <ph name="AI">$1<ex>Claude</ex></ph> is working
+      </message>
+      <message name="IDS_WINDRISE_AI_OPEN_APP" desc="Windrise: panel button that opens the Windrise desktop app">
+        Open Windrise
+      </message>
+      <message name="IDS_WINDRISE_AI_GALLERY" desc="Windrise: panel button that opens the Flash Plaza page">
+        Gallery
+      </message>
+      <message name="IDS_WINDRISE_AI_SETTINGS" desc="Windrise: panel button that opens the AI settings">
+        Settings
+      </message>
+      <message name="IDS_WINDRISE_AI_MINUTES_AGO" desc="Windrise: when an AI was last used, in minutes">
+        <ph name="NUM">$1<ex>2</ex></ph> min ago
+      </message>
+      <message name="IDS_WINDRISE_AI_TODAY_AT" desc="Windrise: when an AI was last used, earlier today; TIME is a 24-hour clock time">
+        Today <ph name="TIME">$1<ex>16:12</ex></ph>
+      </message>
+      <message name="IDS_WINDRISE_AI_YESTERDAY_AT" desc="Windrise: when an AI was last used, yesterday; TIME is a 24-hour clock time">
+        Yesterday <ph name="TIME">$1<ex>16:12</ex></ph>
+      </message>
+      <message name="IDS_WINDRISE_AI_MONTH_DAY" desc="Windrise: when an AI was last used, before yesterday; MONTH and DAY are numbers">
+        <ph name="MONTH">$1<ex>11</ex></ph>/<ph name="DAY">$2<ex>14</ex></ph>
+      </message>
+      <message name="IDS_WINDRISE_AI_MONTH_NAME_DAY" desc="Windrise: when an AI was last used, before yesterday, in English-style UIs; MONTH is the abbreviated month name, DAY a number. Chinese keeps IDS_WINDRISE_AI_MONTH_DAY">
+        <ph name="MONTH">$1<ex>Nov</ex></ph> <ph name="DAY">$2<ex>14</ex></ph>
+      </message>
+      <message name="IDS_WINDRISE_AI_CONNECT" desc="Windrise: wide button in the AI panel that starts connecting another AI">
+        Connect an AI
+      </message>
+      <message name="IDS_WINDRISE_AI_PANEL_OPEN_APP" desc="Windrise: text link at the bottom of the AI panel that opens the Windrise desktop app (short form; Windrise Bridge)">
+        Bridge
+      </message>
+      <message name="IDS_WINDRISE_AI_GALLERY_SOON" desc="Windrise: small note under the Gallery link in the AI panel; the full Gallery is not available yet. Keep it short: the footer row is about 200 px wide.">
+        Coming soon
+      </message>
       <message name="IDS_READ_LATER_MENU_UNREAD_HEADER" desc="Header for section of unread Read later items.">
         Unread
       </message>
@@ -11901,6 +11949,9 @@ Check your passwords anytime in <ph name="GOOGLE_PASSWORD_MANAGER">$1<ex>Google
         <message name="IDS_IMPORT_FROM_FIREFOX" desc="browser combo box: Mozilla Firefox">
