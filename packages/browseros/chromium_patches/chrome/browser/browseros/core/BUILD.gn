diff --git a/chrome/browser/browseros/core/BUILD.gn b/chrome/browser/browseros/core/BUILD.gn
new file mode 100644
index 0000000000..59f6aaaf61
--- /dev/null
+++ b/chrome/browser/browseros/core/BUILD.gn
@@ -0,0 +1,131 @@
+# Copyright 2024 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# BrowserOS core constants and utilities.
+
+source_set("core") {
+  sources = [
+    "browseros_constants.h",
+    "browseros_switches.h",
+  ]
+
+  deps = [
+    "//base",
+  ]
+}
+
+source_set("product") {
+  sources = [
+    "browseros_product.cc",
+    "browseros_product.h",
+    "browseros_product_state.cc",
+    "browseros_product_state.h",
+  ]
+
+  deps = [
+    ":core",
+    "//base",
+    "//chrome/browser/browseros:buildflags",
+  ]
+}
+
+source_set("prefs") {
+  sources = [
+    "browseros_prefs.cc",
+    "browseros_prefs.h",
+  ]
+
+  deps = [
+    ":core",
+    ":product",
+    ":theme",
+    "//base",
+    "//chrome/browser/ui/actions:actions_headers",
+    "//chrome/common:constants",
+    "//components/bookmarks/common",
+    "//components/pref_registry",
+    "//components/prefs",
+    "//ui/actions:actions_headers",
+  ]
+}
+
+# 风桥外观数值（颜色、圆角、尺寸）的偏好与进程级快照。整窗配色 mixer、
+# 布局 provider、ThemeService 都从这里取，改偏好即可运行时改外观。
+source_set("theme") {
+  sources = [
+    "windrise_theme.cc",
+    "windrise_theme.h",
+  ]
+
+  deps = [
+    "//base",
+    "//components/pref_registry",
+    "//components/prefs",
+    "//skia",
+  ]
+}
+
+# 侧栏收起时标签露出的那一个字（theme-v2 §4）。竖向标签和侧栏下段的 AI 组合页
+# 共用，单独成 target，免得 theme 带上 ICU。
+source_set("rail_glyph") {
+  sources = [
+    "windrise_rail_glyph.cc",
+    "windrise_rail_glyph.h",
+  ]
+
+  deps = [
+    "//base",
+    "//base:i18n",
+    "//components/url_formatter",
+    "//third_party/icu",
+  ]
+}
+
+# 扩展推来的 AI 运行状态（哪些标签是 AI 的、哪些在操作、已连接的 AI 列表）。
+# 按浏览器窗口保存；视图 Attach/Detach，扩展接口写入，视图订阅。
+source_set("ai_state") {
+  sources = [
+    "windrise_ai_state.cc",
+    "windrise_ai_state.h",
+  ]
+
+  deps = [
+    "//base",
+    "//chrome/browser/ui/browser_window",
+    "//components/tab_groups",
+  ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "browseros_prefs_unittest.cc" ]
+
+  deps = [
+    ":prefs",
+    ":product",
+    "//base/test:test_support",
+    "//chrome/browser/browseros:buildflags",
+    "//components/bookmarks/browser",
+    "//components/bookmarks/common",
+    "//components/pref_registry",
+    "//components/sync_preferences:test_support",
+    "//testing/gtest",
+  ]
+}
+
+source_set("action_utils") {
+  sources = [
+    "browseros_action_utils.h",
+  ]
+
+  deps = [
+    ":core",
+    "//base",
+    "//chrome/browser/ui:ui_features",
+    "//chrome/browser/ui/actions:actions_headers",
+    "//chrome/browser/ui/views/side_panel",
+    "//chrome/common:chrome_features",
+    "//ui/actions",
+  ]
+}
