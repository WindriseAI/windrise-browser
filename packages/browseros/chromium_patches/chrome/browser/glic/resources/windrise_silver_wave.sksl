diff --git a/chrome/browser/glic/resources/windrise_silver_wave.sksl b/chrome/browser/glic/resources/windrise_silver_wave.sksl
new file mode 100644
index 0000000..5d8bc3c
--- /dev/null
+++ b/chrome/browser/glic/resources/windrise_silver_wave.sksl
@@ -0,0 +1,150 @@
+// Windrise Browser：AI 操作时网页四周的「银色海浪」流光（第四版，11-13 按独立挑刺和参考范例重做）。
+//
+// 上一版的毛病（挑刺第 1、2 条）：往里铺的白雾在 64px 处被硬截断，四条内边围成一个矩形；外面看不到辉光，书签栏的字反而被罩灰。
+// 这一版照三个成熟实现的做法（参考记录见 browser-design/参考记录.md）：
+//   - Apple Intelligence 边缘光的公开复刻（Livsy90/IntelligenceGlow、jacobamobin/AppleIntelligenceGlowEffect，SwiftUI）：
+//     4 层「描在边上的线」，线宽 6/9/11/15、模糊 0/4/12/15，每层自己的节奏变化（0.5/0.6/0.8/1.0 秒），层与层不同步；
+//     「紧的芯 + 柔的晕 + 淡的雾」。光是描在边上再模糊出来的，所以里外都是自然衰减，没有内边。
+//   - Chrome 自带的 Glic 边框（编译树 chrome/browser/glic/resources/border.sksl）：往里 25px、透明度 (1-d/extent)^2，衰减到正好 0。
+//   - 官网首页银浪（edge-flow.js）：白光模糊后往外漫、往里压。
+// 我们的做法：三层高斯「描边」以网页边缘为中心（芯 σ≈1.2、晕 σ≈6、雾 σ≈16，宽度随位置起伏 ±40%），
+// 每层的亮度和宽度由沿边一圈的「噪声」决定，三层噪声速度不同、方向相反（一圈 3–7 段起伏、每秒挪 0.12–0.3 圈），
+// 所以亮的地方一段段沿边跑，不是整圈同步明暗；里面衰减到 0，外面同样的衰减但窄一半、淡一点（标签栏、工具栏那一侧的辉光）。
+// 颜色：网页多是浅色，纯白看不见，所以芯和晕在「深银 #8C96A1 ↔ 白」之间随噪声变，雾是浅银灰。
+//
+// 原生用法：资源 IDR_WINDRISE_SILVER_WAVE_SHADER，挂在 158 已编进的 AnimatedEffectView（每个 vsync 一次 OnAnimationStep，
+// 120Hz 屏 120 帧），u_time 用时间戳差（秒）。层的范围 = 网页区向外扩 24px。效果图 mock/browser.html 用 WebGL 跑的就是这一份源码。
+
+uniform float u_time;        // 秒
+uniform float u_k;           // 0..1：整体强度（出现 / 淡出）
+uniform float u_intro;       // 0..1：开场那一道沿边跑一圈的亮光走到哪；跑完后停在 1
+uniform float u_scale;       // 设备像素比
+uniform vec2 u_resolution;   // 本层像素尺寸
+uniform vec4 u_rect;         // 网页区（x, y, w, h），像素
+uniform vec4 u_radii;        // 光的距离场用的四角半径（左上、右上、右下、左下），像素
+uniform float u_still;       // 1 = 减少动态效果：不流动，常亮
+// 风桥：银色各层颜色也从外观偏好来（下面的默认值就是设计稿里的常量），由
+// WindriseSilverWaveView 以 browseros.windrise.theme.*.silver_wave_* 填。
+uniform vec4 u_silver_wash;         // 雾（原 vec3(0.690,0.722,0.757)）
+uniform vec4 u_silver_soft_deep;    // 晕的暗处（原 vec3(0.549,0.588,0.631)）
+uniform vec4 u_silver_soft_bright;  // 晕的亮处（原 vec3(0.957,0.965,0.973)）
+uniform vec4 u_silver_core_deep;    // 芯的暗处（原 vec3(0.478,0.522,0.573)）
+uniform vec4 u_silver_core_bright;  // 芯的亮处（原 vec3(1.0)）
+
+const float TAU = 6.28318530718;
+
+// 圆角矩形：返回 (往里的距离（外面为负）, 沿边一圈的位置 0..1)。一圈从左上圆角右端出发，顺时针。
+vec2 edgeCoord(vec2 p) {
+  float x = p.x - u_rect.x;
+  float y = p.y - u_rect.y;
+  float w = u_rect.z;
+  float h = u_rect.w;
+  float m = 0.5 * min(w, h);
+  float r0 = max(min(u_radii.x, m), 0.5);
+  float r1 = max(min(u_radii.y, m), 0.5);
+  float r2 = max(min(u_radii.z, m), 0.5);
+  float r3 = max(min(u_radii.w, m), 0.5);
+  float top = w - r0 - r1;
+  float right = h - r1 - r2;
+  float bottom = w - r2 - r3;
+  float left = h - r3 - r0;
+  float q0 = TAU * r0 / 4.0;
+  float q1 = TAU * r1 / 4.0;
+  float q2 = TAU * r2 / 4.0;
+  float q3 = TAU * r3 / 4.0;
+  float L = top + right + bottom + left + q0 + q1 + q2 + q3;
+  float d = 0.0;
+  float inward = 0.0;
+  if (x < r0 && y < r0) {
+    vec2 v = vec2(x - r0, y - r0);
+    inward = r0 - length(v);
+    d = top + q1 + right + q2 + bottom + q3 + left + r0 * atan(-v.y, -v.x);
+  } else if (x > w - r1 && y < r1) {
+    vec2 v = vec2(x - (w - r1), y - r1);
+    inward = r1 - length(v);
+    d = top + r1 * atan(v.x, -v.y);
+  } else if (x > w - r2 && y > h - r2) {
+    vec2 v = vec2(x - (w - r2), y - (h - r2));
+    inward = r2 - length(v);
+    d = top + q1 + right + r2 * atan(v.y, v.x);
+  } else if (x < r3 && y > h - r3) {
+    vec2 v = vec2(x - r3, y - (h - r3));
+    inward = r3 - length(v);
+    d = top + q1 + right + q2 + bottom + r3 * atan(-v.x, v.y);
+  } else {
+    float dt = y;
+    float dr = w - x;
+    float db = h - y;
+    float dl = x;
+    float mm = min(min(dt, dr), min(db, dl));
+    inward = mm;
+    if (mm == dt) d = x - r0;
+    else if (mm == dr) d = top + q1 + (y - r1);
+    else if (mm == db) d = top + q1 + right + q2 + (w - r2 - x);
+    else d = top + q1 + right + q2 + bottom + q3 + (h - r3 - y);
+  }
+  return vec2(inward, fract(d / L));
+}
+
+// 沿一圈周期的平滑噪声（0..1）：三段不同频率、不同速度的正弦叠加，像 Apple 复刻里每隔 0.4 秒换一组渐变色标再缓动过去
+float flow(float s, float t, float f1, float v1, float f2, float v2, float ph) {
+  float a = sin(TAU * (s * f1 + t * v1 + ph));
+  float b = sin(TAU * (s * f2 - t * v2 + ph * 1.7));
+  float c = sin(TAU * (s * (f1 + f2) + t * (v1 - v2) * 0.5 + ph * 0.6));
+  return clamp(0.5 + 0.30 * a + 0.22 * b + 0.12 * c, 0.0, 1.0);
+}
+
+float bump(float s, float c, float wid) {
+  float d = abs(fract(s - c + 0.5) - 0.5);
+  return exp(-(d * d) / (wid * wid));
+}
+
+vec4 over(vec4 dst, vec3 rgb, float a) {
+  return vec4(rgb * a, a) + dst * (1.0 - a);
+}
+
+// 以网页边缘为中心的高斯「描边」：里面 σ，外面 σ*outScale；衰减到 0，没有边
+float stroke(float x, float sigma, float outScale) {
+  float sg = x >= 0.0 ? sigma : sigma * outScale;
+  return exp(-(x * x) / (2.0 * sg * sg));
+}
+
+vec4 main(vec2 coord) {
+  if (u_k <= 0.0) return vec4(0.0);
+  vec2 ec = edgeCoord(coord);
+  float x = ec.x / u_scale;                    // 逻辑像素：里面为正、外面为负
+  float s = ec.y;
+  if (x < -30.0 || x > 90.0) return vec4(0.0);  // 此处高斯已小于 0.0001，截掉不可见
+  float t = u_still > 0.5 ? 0.0 : u_time;
+
+  // 三层各自的起伏：频率（一圈几段）和速度（每秒几圈）都不同，雾和芯反向
+  float nCore = flow(s, t, 5.0, 0.31, 3.0, 0.23, 0.00);
+  float nBloom = flow(s, t, 3.0, -0.19, 4.0, 0.27, 0.37);
+  float nWash = flow(s, t, 2.0, 0.12, 3.0, -0.16, 0.71);
+
+  // 开场：一道亮光沿边跑一圈（900ms），光带跟在后面亮起
+  float intro = clamp(u_intro, 0.0, 1.0);
+  float behind = intro >= 1.0 ? 1.0 : smoothstep(intro + 0.02, intro - 0.08, s);
+  float head = intro >= 1.0 ? 0.0 : bump(s, intro, 0.03);
+  float k = u_k;
+
+  vec4 c = vec4(0.0);
+  // 雾：浅银灰，宽、淡；外面窄一半
+  float sWash = 16.0 * (0.6 + 0.8 * nWash);
+  float aWash = 0.38 * (0.35 + 0.65 * nWash) * stroke(x, sWash, 0.4) * behind;
+  c = over(c, u_silver_wash.rgb, clamp(k * aWash, 0.0, 1.0));
+  // 晕：深银到亮银随噪声变
+  float sBloom = 6.0 * (0.6 + 0.8 * nBloom);
+  float aBloom = 0.68 * (0.30 + 0.70 * nBloom) * stroke(x, sBloom, 0.55) * behind;
+  vec3 cBloom = mix(u_silver_soft_deep.rgb, u_silver_soft_bright.rgb, smoothstep(0.35, 0.85, nBloom));
+  c = over(c, cBloom, clamp(k * aBloom, 0.0, 1.0));
+  // 芯：贴着网页边缘一根细亮线，亮处发白、暗处深银，跟着噪声沿边跑
+  float sCore = 1.2 * (0.7 + 0.6 * nCore);
+  float aCore = 0.85 * (0.25 + 0.75 * nCore) * stroke(x - 0.6, sCore, 0.8) * behind;
+  vec3 cCore = mix(u_silver_core_deep.rgb, u_silver_core_bright.rgb, smoothstep(0.45, 0.9, nCore));
+  c = over(c, cCore, clamp(k * aCore, 0.0, 1.0));
+  // 开场那道光：亮白的一团沿边走
+  float aHead = head * (stroke(x, 10.0, 0.6) * 0.75 + stroke(x - 0.6, 1.6, 0.8) * 0.9);
+  c = over(c, vec3(1.0), clamp(k * aHead, 0.0, 1.0));
+  return c;
+}
